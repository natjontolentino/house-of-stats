{
  "name": "basketball-stats-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "shared:build": "npm run build --workspace=packages/shared",
    "web:dev": "npm run dev --workspace=apps/web",
    "mobile:start": "npm run start --workspace=apps/mobile",
    "seed": "npm run seed --workspace=packages/shared",
    "test": "npm run test --workspace=packages/shared",
    "typecheck": "npm run typecheck --workspace=packages/shared && npm run typecheck --workspace=apps/web && npm run typecheck --workspace=apps/mobile"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
